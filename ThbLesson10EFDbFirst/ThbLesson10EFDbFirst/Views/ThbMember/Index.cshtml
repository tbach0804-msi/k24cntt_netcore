@model IEnumerable<ThbLesson10EFDbFirst.Models.ThbMember>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.ThbUserName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ThbPassword)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ThbFullName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ThbEmail)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ThbPhone)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ThbStatus)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.ThbUserName)
            </td>
            <td>
                @Html.DisplayFor(model => item.ThbPassword)
            </td>
            <td>
                @Html.DisplayFor(model => item.ThbFullName)
            </td>
            <td>
                @Html.DisplayFor(model => item.ThbEmail)
            </td>
            <td>
                @Html.DisplayFor(model => item.ThbPhone)
            </td>
            <td>
                @Html.DisplayFor(model => item.ThbStatus)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
