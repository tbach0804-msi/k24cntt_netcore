@model List<lesson03.Models.ThbProduct>
@{
    ViewData["Title"] = "Danh sach san pham";


    int stt = 0;
}

<h1>ThbGetAllProduct</h1>
<div class="card">
    <div class="card-header">
        <h1>@ViewData["Title"]</h1>
    </div>
    <div class="card-body">
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>#</th>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Year</th>
                    <th>Price</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (ThbProduct item in Model)
                {
                    stt++;
                    <tr>
                        <td>@stt</td>
                        <td>@item.ThbProductId</td>
                        <td>@item.ThbProductName</td>
                        <td>@item.ThbYearRelease</td>
                        <td>@item.ThbPrice</td>
                        <td>
                            <a href="#">Xem</a>
                            <a href="#">Xoa</a>
                            <a href="#">Sua</a>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="6">Tổng số sản phẩm: @Model.Count</th>
                </tr>
            </tfoot>
        </table>

    </div>
</div>