@model TrinhHoangBach2410900008_exam.Models.ThbStudent

@{
    ViewData["Title"] = "Thêm sinh viên";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">THÊM SINH VIÊN</h3>
        </div>

        <div class="card-body">
            <form asp-action="Create" method="post">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <!-- Họ và tên -->
                <div class="mb-3">
                    <label asp-for="HvtName" class="form-label">
                        Họ và tên
                    </label>

                    <input asp-for="HvtName"
                           class="form-control"
                           placeholder="Nhập họ và tên" />

                    <span asp-validation-for="HvtName"
                          class="text-danger"></span>
                </div>

                <!-- Giới tính -->
                <div class="mb-3">
                    <label class="form-label">Giới tính</label>

                    <div class="form-check">
                        <input asp-for="HvtGender"
                               class="form-check-input"
                               type="radio"
                               value="true"
                               id="nam" />

                        <label class="form-check-label" for="nam">
                            Nam
                        </label>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input"
                               type="radio"
                               name="HvtGender"
                               value="false"
                               id="nu" />

                        <label class="form-check-label" for="nu">
                            Nữ
                        </label>
                    </div>

                    <span asp-validation-for="HvtGender"
                          class="text-danger"></span>
                </div>

                <!-- Ngày sinh -->
                <div class="mb-3">
                    <label asp-for="HvtBirthDay" class="form-label">
                        Ngày sinh
                    </label>

                    <input asp-for="HvtBirthDay"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="HvtBirthDay"
                          class="text-danger"></span>
                </div>

                <!-- Email -->
                <div class="mb-3">
                    <label asp-for="HvtEmail" class="form-label">
                        Email
                    </label>

                    <input asp-for="HvtEmail"
                           type="email"
                           class="form-control"
                           placeholder="example@gmail.com" />

                    <span asp-validation-for="HvtEmail"
                          class="text-danger"></span>
                </div>

                <!-- Số điện thoại -->
                <div class="mb-3">
                    <label asp-for="HvtPhone" class="form-label">
                        Số điện thoại
                    </label>

                    <input asp-for="HvtPhone"
                           class="form-control"
                           placeholder="Nhập số điện thoại" />

                    <span asp-validation-for="HvtPhone"
                          class="text-danger"></span>
                </div>

                <!-- Trạng thái -->
                <div class="mb-3">
                    <div class="form-check">
                        <input asp-for="HvtActive"
                               class="form-check-input"
                               type="checkbox" />

                        <label asp-for="HvtActive"
                               class="form-check-label">
                            Đang hoạt động
                        </label>
                    </div>

                    <span asp-validation-for="HvtActive"
                          class="text-danger"></span>
                </div>

                <!-- Nút -->
                <div class="mt-4">
                    <button type="submit"
                            class="btn btn-primary">
                        <i class="bi bi-plus-circle"></i>
                        Thêm sinh viên
                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary ms-2">
                        Quay lại danh sách
                    </a>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}